{
  // קוד השרת רץ ב-Cloudflare Workers ולא בדפדפן, ולכן בלי DOM ועם הטיפוסים של Workers.
  // worker-configuration.d.ts נוצר עם: npm run types:worker (אחרי כל שינוי ב-wrangler.jsonc)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["*.ts"]
}
